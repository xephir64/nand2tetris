// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    Inc16(in=tempOut, out=incr);
    Mux16(a=tempOut, b=incr, sel=inc, out=t1);
    Mux16(a=t1, b=in, sel=load, out=t2);
    Mux16(a=t2, b=false, sel=reset, out=tIN);


    Or(a=reset, b=load, out=rl);
    Or(a=rl, b=inc, out=rli);



    Register(in=tIN, load=rli, out=out, out=tempOut);
}